{
	"name": "suonetar",
	"version": "0.0.0",
	"private": true,
	"description": "Commit-stack editor for plain git",
	"type": "module",
	"license": "UNLICENSED",
	"main": "out/main/index.js",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"test": "vitest run",
		"test:watch": "vitest",
		"check": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json && biome check .",
		"fix": "biome check --write .",
		"smoke": "node src/cli/smoke.ts",
		"app": "electron-vite preview --",
		"dev": "electron-vite dev --"
	},
	"dependencies": {
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.12.4",
		"@codemirror/language-data": "^6.5.2",
		"@codemirror/merge": "^6.12.2",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/theme-one-dark": "^6.1.3",
		"@codemirror/view": "^6.43.13"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/node": "^24.19.0",
		"electron": "^44.5.1",
		"electron-vite": "^5.0.0",
		"typescript": "^7.0.2",
		"vite": "^7.3.6",
		"vitest": "^5.0.3"
	}
}
